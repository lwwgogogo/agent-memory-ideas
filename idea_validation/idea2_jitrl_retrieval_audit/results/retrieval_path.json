{
  "anchors": {
    "agent_calls_add_episode": true,
    "agent_calls_retrieve_similar": true,
    "embedding_requires_openai_key2": true,
    "empty_guard_before_null_vector_guard": true,
    "faiss_add": true,
    "faiss_import": true,
    "index_flat_ip": true,
    "index_guard_before_search": true,
    "index_none_when_faiss_missing": true,
    "jaccard_filter": true,
    "retrieve_ignores_use_vector": true,
